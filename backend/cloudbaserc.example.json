{
  "version": "2.0",
  "$schema": "https://framework-1258016615.tcloudbaseapp.com/schema/latest.json",
  "envId": "<your-env-id>",
  "functionRoot": "./cloudfunctions",
  "functions": [
    {
      "name": "api",
      "timeout": 20,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "memorySize": 256,
      "envVariables": {
        "MODE": "cloud",
        "JWT_SECRET": "<run: openssl rand -hex 32>",
        "SMTP_HOST": "<如 smtp.exmail.qq.com>",
        "SMTP_PORT": "465",
        "SMTP_USER": "<发信邮箱账号>",
        "SMTP_PASS": "<发信邮箱密码/授权码>",
        "SMTP_FROM": "<发件人，留空则用 SMTP_USER>"
      }
    }
  ]
}