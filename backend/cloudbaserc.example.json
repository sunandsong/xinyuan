{
  "version": "2.0",
  "$schema": "https://framework-1258016615.tcloudbaseapp.com/schema/latest.json",
  "envId": "<your-env-id>",
  "functionRoot": "./cloudfunctions",
  "functions": [
    {
      "name": "api",
      "timeout": 20,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "memorySize": 256,
      "envVariables": {
        "MODE": "cloud",
        "JWT_SECRET": "<run: openssl rand -hex 32>"
      }
    }
  ]
}